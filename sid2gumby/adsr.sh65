# ADSR

repeat() {
    while test -n "$1" ; do
        yes "$1" | head -n $2 | tr '\n' ' '
        shift 2
    done
}

do_envelope() {
    eval L do_envelope_$1

    # if gate, set phase to 3, if !gate and phase==3, set to 0

    eval lda \$s${1}_gate
    eval bne \$gate_is_on_$1

    lda. 3
    eval sta \$s${1}_envphase
    eval bne \$do_phases_$1

    eval L gate_is_on_$1

    eval lda \$s${1}_envphase
    cmp. 3
    eval bne \$do_phases_$1
    lda. 0
    eval sta \$s${1}_envphase
    eval sta \$s${1}_enval
    eval sta \$\(\(\$s${1}_enval + 1\)\)

    eval L do_phases_$1

    # "switch" statement

    eval lda \$s${1}_envphase
    cmp. 3
    eval bne \$not_case3_$1
    eval jmp \$case3_$1

    eval L not_case3_$1
    cmp. 2
    eval bne \$not_case2_$1
    eval jmp \$case2_$1

    eval L not_case2_$1
    cmp. 1
    eval bne \$case0_$1
    eval jmp \$case1_$1

# Case 0
    eval L case0_$1

    clc
    eval lda \$s${1}_enval
    eval adc \$s${1}_attack
    eval sta \$s${1}_enval
    eval lda \$\(\(\$s${1}_enval + 1\)\)
    eval adc \$\(\(\$s${1}_attack + 1\)\)
    eval sta \$\(\(\$s${1}_enval + 1\)\)

    cmp. 0x0f
    eval bcs \$fix$1

    lda. 0x0f

    eval L fix$1
    tax
    lda $phase0,x
    eval sta \$s${1}_envphase

    eval jmp \$copy_to_volume_$1

# Case 1
    eval L case1_$1

    sec
    eval lda \$s${1}_enval
    eval sbc \$s${1}_decay
    eval sta \$s${1}_enval
    eval lda \$\(\(\$s${1}_enval + 1\)\)
    eval sbc \$\(\(\$s${1}_decay + 1\)\)
    eval sta \$\(\(\$s${1}_enval + 1\)\)

    and. 15
    asl.a
    asl.a
    asl.a
    asl.a
    eval ora \$s${1}_sustain
    tax
    lda $envsuslut,x
    eval sta \$\(\(\$s${1}_enval + 1\)\)
    lda $phase1,x
    eval sta \$s${1}_envphase

    eval jmp \$copy_to_volume_$1

# Case 2
    eval L case2_$1

    eval lda \$\(\(\$s${1}_enval + 1\)\)
    eval eor \$s${1}_sustain
    tax
    lda $phase2,x
    eval sta \$s${1}_envphase

    eval jmp \$copy_to_volume_$1

# Case 3
    eval L case3_$1

    sec
    eval lda \$s${1}_enval
    eval sbc \$s${1}_release
    eval sta \$s${1}_enval
    eval lda \$\(\(\$s${1}_enval + 1\)\)
    eval sbc \$\(\(\$s${1}_release + 1\)\)
    eval sta \$\(\(\$s${1}_enval + 1\)\)

    eval bpl \$copy_to_volume_$1

    lda. 0x40
    eval sta \$s${1}_enval
    lda. 0x00
    eval sta \$\(\(\$s${1}_enval + 1\)\)

    eval L copy_to_volume_$1
 
    eval lda \$\(\(\$s${1}_enval + 1\)\)
#    lsr.a
#    lsr.a
    eval sta \$volume_v$1

    rts
}

extract_adsr_values() {
    eval lda \$SIDV${1}AD
    tax
    lsr.a
    lsr.a
    lsr.a
    lsr.a
    asl.a
    tax
    lda $attacks,x
    eval sta \$s${1}_attack
    inx
    lda $attacks,x
    eval sta \$\(\(\$s${1}_attack +1\)\)

    txa
    and. 0x0f
    asl.a
    tax
    lda $releases,x
    eval sta \$s${1}_decay
    inx
    lda $releases,x
    eval sta \$\(\(\$s${1}_decay +1\)\)

    eval lda \$SIDV${1}SR
    tax
    lsr.a
    lsr.a
    lsr.a
    lsr.a
    eval sta \$s${1}_sustain
    txa
    and. 0x0f
    asl.a
    tax
    lda $releases,x
    eval sta \$s${1}_release
    inx
    lda $releases,x
    eval sta \$\(\(\$s${1}_release +1\)\)

    eval lda \$SIDV${1}CTRL
    tax
    and. 1
    eval sta \$s${1}_gate
    txa
    and. 8
    eval sta \$s${1}_test
}

